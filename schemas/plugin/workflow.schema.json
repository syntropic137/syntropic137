{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syntropic137.dev/schemas/plugin/v0.28.0-beta.4/workflow.schema.json",
  "$defs": {
    "AgentYamlDefinition": {
      "additionalProperties": false,
      "description": "Per-phase ``agent`` block as parsed from YAML.\n\nSelects which headless agent provider drives the phase (``claude`` for\nthe default ``claude -p`` docker-exec path, ``codex`` for the\nprogrammatic ``codex exec`` harness on the same path) and optionally\nthe model.",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "enum": [
                "claude",
                "codex"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "allow_delegation": {
          "default": false,
          "title": "Allow Delegation",
          "type": "boolean"
        }
      },
      "title": "AgentYamlDefinition",
      "type": "object"
    },
    "ClaudePluginRef": {
      "anyOf": [
        {
          "description": "Shorthand form: 'org/repo@version' or '<url>@<version>'. '@latest' is rejected.",
          "minLength": 1,
          "type": "string"
        },
        {
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "source"
              ]
            },
            {
              "required": [
                "source_url"
              ]
            }
          ],
          "description": "Verbose mapping form: 'source' (or 'source_url') plus 'version', with an optional 'name' override.",
          "properties": {
            "source": {
              "minLength": 1,
              "type": "string"
            },
            "source_url": {
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "name_overridden": {
              "type": "boolean"
            }
          },
          "required": [
            "version"
          ],
          "type": "object"
        }
      ],
      "description": "A workflow-declared reference to a Claude Code plugin.\n\nCompared and hashed by ``(source_url, version, name)`` to match the lock\nprojection key (issue #726). A workflow author who installs the same\nplugin under two different display names produces two distinct lock\nentries -- the materializer needs both to write the right files.",
      "title": "ClaudePluginRef"
    },
    "InputYamlDefinition": {
      "additionalProperties": false,
      "description": "Input declaration as parsed from YAML.\n\nMaps to domain InputDeclaration.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "name"
      ],
      "title": "InputYamlDefinition",
      "type": "object"
    },
    "PhaseExecutionType": {
      "description": "How a phase should be executed.",
      "enum": [
        "sequential",
        "parallel",
        "human_in_loop"
      ],
      "title": "PhaseExecutionType",
      "type": "string"
    },
    "PhaseYamlDefinition": {
      "additionalProperties": false,
      "description": "Phase definition as parsed from YAML.\n\nConverts YAML snake_case to domain PhaseDefinition.",
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "execution_type": {
          "$ref": "#/$defs/PhaseExecutionType",
          "default": "sequential"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "input_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Input Artifacts",
          "type": "array"
        },
        "output_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Output Artifacts",
          "type": "array"
        },
        "prompt_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Template"
        },
        "prompt_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt File"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "allowed_tools": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array"
        },
        "argument_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Argument Hint"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentYamlDefinition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "claude_plugins": {
          "items": {
            "$ref": "#/$defs/ClaudePluginRef"
          },
          "title": "Claude Plugins",
          "type": "array"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillRef"
          },
          "title": "Skills",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "order"
      ],
      "title": "PhaseYamlDefinition",
      "type": "object"
    },
    "RepositoryConfig": {
      "additionalProperties": false,
      "description": "Repository configuration for a workflow.",
      "properties": {
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "ref": {
          "default": "main",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "RepositoryConfig",
      "type": "object"
    },
    "SkillRef": {
      "anyOf": [
        {
          "description": "Shorthand form: 'org/repo/skill-name@version' or '<url>@<version>'. '@latest' is rejected.",
          "minLength": 1,
          "type": "string"
        },
        {
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "source"
              ]
            },
            {
              "required": [
                "source_url"
              ]
            }
          ],
          "description": "Verbose mapping form: 'source' (or 'source_url') plus 'version', with an optional 'name' override or 'names' list to expand into multiple refs.",
          "properties": {
            "source": {
              "minLength": 1,
              "type": "string"
            },
            "source_url": {
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "names": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "name_overridden": {
              "type": "boolean"
            }
          },
          "required": [
            "version"
          ],
          "type": "object"
        }
      ],
      "description": "A workflow-declared reference to an agent skill (issue #772).\n\nCompared and hashed by ``(source_url, version, skill_name)`` to match\nthe lock projection key. A repo publishing many skills produces one\nref (and one lock entry) per declared skill.",
      "title": "SkillRef"
    },
    "WorkflowClassification": {
      "description": "Classification of workflow complexity.",
      "enum": [
        "simple",
        "standard",
        "complex",
        "epic"
      ],
      "title": "WorkflowClassification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Complete workflow definition as parsed from YAML.\n\nThis is the root model for workflow YAML files.",
  "properties": {
    "id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "type": {
      "default": "custom",
      "title": "Type",
      "type": "string"
    },
    "classification": {
      "$ref": "#/$defs/WorkflowClassification",
      "default": "standard"
    },
    "repository": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepositoryConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repos": {
      "items": {
        "type": "string"
      },
      "title": "Repos",
      "type": "array"
    },
    "requires_repos": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requires Repos"
    },
    "project_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Name"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputYamlDefinition"
      },
      "title": "Inputs",
      "type": "array"
    },
    "phases": {
      "items": {
        "$ref": "#/$defs/PhaseYamlDefinition"
      },
      "minItems": 1,
      "title": "Phases",
      "type": "array"
    },
    "claude_plugins": {
      "items": {
        "$ref": "#/$defs/ClaudePluginRef"
      },
      "title": "Claude Plugins",
      "type": "array"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/SkillRef"
      },
      "title": "Skills",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "phases"
  ],
  "title": "WorkflowDefinition",
  "type": "object"
}
