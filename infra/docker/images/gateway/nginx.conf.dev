# Dev-mode nginx config for the gateway image.
#
# Production gateway (default nginx.conf) serves a baked-in dashboard
# build and authenticates the tunnel port. Dev mode does neither:
# - Dashboard is proxied to the dashboard-dev container running Vite
#   so file edits trigger HMR
# - Single port 80, no auth, no tunnel block
#
# Mounted into the container via docker-compose.dev.yaml as
# /etc/nginx/conf.d/default.conf (overrides the baked file).

server {
    listen 80;
    server_name _;
    server_tokens off;

    # Allow large plugin tree uploads (POST /claude-plugins/registrations).
    # Production sets this too; dev mirrors so payload limits do not differ.
    client_max_body_size 50M;

    # ===========================================================================
    # API routes: strip /api/v1 prefix, forward to the API container.
    # Mirrors production behavior so the CLI works against the dev stack
    # without SYN_NO_PREFIX=1. Closes #762.
    # ===========================================================================
    location /api/v1/ {
        rewrite ^/api/v1/(.*)$ /$1 break;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE endpoints need long timeouts + disabled buffering
        proxy_buffering off;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
    }

    # GitHub webhook bypass (no auth in dev anyway; matches prod's location shape).
    location = /api/v1/webhooks/github {
        rewrite ^/api/v1/(.*)$ /$1 break;
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # ===========================================================================
    # Dashboard: proxy everything else to the Vite dev server.
    # The Upgrade/Connection headers are critical for Vite HMR WebSocket.
    # ===========================================================================
    location / {
        proxy_pass http://dashboard-dev:5173;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Vite's HMR + long-lived WebSocket need generous timeouts.
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
    }
}
