#!/usr/bin/env bash
# Pre-push hook — catches the most common CI failures locally before they waste a round-trip.
# Runs `just preflight` - the same target CI runs. Slower than the old
# hand-rolled list, and it catches what that list could not.
set -euo pipefail

# ONE target, shared with CI and the AGENTS.md checklist. This hook used to
# carry its own list and ran only the THRESHOLD half of fitness, so
# cross-context and ES invariant failures could only surface after a push.
echo "▶ pre-push: preflight (every CI gate)..."
just preflight

echo "✓ pre-push checks passed"
