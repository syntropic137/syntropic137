{
  "name": "@syn137/skyline-core",
  "version": "1.0.0",
  "private": true,
  "description": "Skyline plain-TypeScript core: upstream contract re-exports, formatters, chart geometry, state machines, pattern prop types. No DOM, no Svelte.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./format": "./src/format/index.ts",
    "./geometry": "./src/geometry/index.ts",
    "./state": "./src/state/index.ts",
    "./patterns": "./src/patterns/index.ts",
    "./screens/*": "./src/screens/*/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "og-image": "tsx scripts/og-image.ts",
    "repo-banner": "tsx scripts/repo-banner.ts"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@syntropic137/design-contracts": "0.1.1"
  }
}
