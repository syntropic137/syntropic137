{
  "name": "@syn137/syn-ui-data",
  "version": "0.33.1",
  "private": true,
  "description": "Plain-TypeScript API client for the Skyline UI: typed resources, live event stream, request coalescing, and a fixtures mode.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./live": "./src/live/index.ts",
    "./invalidate": "./src/live/invalidate.ts",
    "./fixtures": "./src/fixtures/index.ts"
  },
  "files": ["src"],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:types": "node scripts/generate-types.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.8.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
