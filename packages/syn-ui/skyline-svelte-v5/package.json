{
  "name": "@syn137/skyline-svelte-v5",
  "version": "0.33.1",
  "private": true,
  "description": "Skyline Svelte 5 (runes) components and patterns. Plain CSS over --ds-*/--sky-* tokens; no colour literals.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./patterns": {
      "types": "./src/patterns/index.ts",
      "svelte": "./src/patterns/index.ts",
      "default": "./src/patterns/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./examples": {
      "types": "./src/examples.ts",
      "default": "./src/examples.ts"
    },
    "./elements": {
      "types": "./src/elements/types.ts",
      "default": "./dist-elements/index.js"
    },
    "./elements/react": {
      "types": "./types/react-jsx.d.ts"
    },
    "./elements/*": {
      "types": "./src/elements/types.ts",
      "default": "./dist-elements/*.js"
    }
  },
  "files": [
    "src",
    "types",
    "dist-elements"
  ],
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && node ../scripts/check-css.mjs src",
    "build": "pnpm run typecheck && pnpm run check",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error && tsc -p tsconfig.json --noEmit && tsc -p types/tsconfig.json --noEmit",
    "build:ce": "vite build --config vite.ce.config.ts",
    "test": "vitest run --passWithNoTests",
    "build:elements": "vite build --config vite.elements.config.ts"
  },
  "peerDependencies": {
    "svelte": "^5.30.0"
  },
  "dependencies": {
    "@syn137/skyline-core": "workspace:*",
    "@syn137/skyline-themes": "workspace:*"
  },
  "devDependencies": {
    "@lucide/svelte": "1.52.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.14",
    "jsdom": "30.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
