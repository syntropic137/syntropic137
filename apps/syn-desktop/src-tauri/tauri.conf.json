{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syntropic137",
  "version": "0.1.0",
  "identifier": "com.syntropic137.desktop",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../../syn-ui/dist",
    "beforeDevCommand": "pnpm --filter syn-ui dev",
    "beforeBuildCommand": "pnpm --filter syn-ui build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Syntropic137",
        "width": 1400,
        "height": 900,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["syn137"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Syntropic137 desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
