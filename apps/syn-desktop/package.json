{
  "name": "syn-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Syntropic137 desktop app: a Tauri 2 shell around the Skyline web app (apps/syn-ui).",
  "type": "module",
  "exports": {
    "./bridge": "./bridge/index.ts"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "check": "tsc -p tsconfig.json && cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "node --experimental-strip-types --no-warnings --test bridge/index.test.ts && cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "python3 scripts/make-icons.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "typescript": "5.9.3"
  }
}
