# Syn137 Dashboard - dev container with Vite hot reload
#
# Lives only in docker-compose.dev.yaml. Production uses the baked-in
# build in infra/docker/images/gateway/Dockerfile.
#
# Source code is mounted at runtime so file edits trigger Vite HMR.
# node_modules is baked here (and shielded from the host mount via a
# named volume in compose) because cross-OS node_modules from macOS host
# do not work in a Linux container.

FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@10.24.0 --activate

WORKDIR /workspace

# Workspace config + lockfile for cached pnpm install
COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY apps/syn-dashboard-ui/package.json ./apps/syn-dashboard-ui/

RUN pnpm install --frozen-lockfile --filter syn-dashboard-ui

WORKDIR /workspace/apps/syn-dashboard-ui

# macOS bind-mount inotify does not propagate; chokidar polling fills the gap
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

EXPOSE 5173

# Bind to 0.0.0.0 so the gateway container can reach Vite.
# Strict-port so a port collision is loud, not silently re-allocated.
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
